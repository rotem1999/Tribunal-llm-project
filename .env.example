# Tribunal API environment (SPEC §9).
# Copy to `.env` at the workspace root and fill in the required values.
# Required: OPENROUTER_API_KEY, DATABASE_URL, JWT_SECRET, SEED_USERNAME,
#           SEED_PASSWORD, CORS_ORIGINS. Everything else has a safe default.
# NEVER commit a real .env — only this example is tracked.

# --- OpenRouter (SPEC §5) ---
# Get a key at https://openrouter.ai. Free models also require enabling the two
# "free endpoint" privacy toggles in OpenRouter Settings → Privacy (SPEC §5.3).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=Tribunal
# Optional, sent as HTTP-Referer for attribution:
OPENROUTER_APP_URL=
# Optional: pin Mode A's single model id; leave blank to auto-pick a free model:
MODE_A_MODEL=
# Optional: extra comma-separated substrings that exclude a "free" model from
# being an advocate/judge (matched case-insensitively against the model id), on
# top of the built-in task-type blacklist (classifiers, embedders, audio, etc.):
MODEL_BLACKLIST=

# --- Run economy / model tuning (SPEC §2.1, §5) ---
RUN_COST_CEILING_USD=5
ADVOCATE_TEMPERATURE=0.9
JUDGE_TEMPERATURE=0.2
MODEL_MAX_TOKENS=1024
CALL_TIMEOUT_MS=90000
# Disable model "reasoning" on persona calls (default true). Many free models
# otherwise dump their whole chain-of-thought into the reply and run out of
# tokens before giving the verdict; a model that refuses is swapped out. Set to
# false only if you deliberately want reasoning-model output.
DISABLE_MODEL_REASONING=true

# --- Diagnostic logging (SPEC §5.7) ---
# Durable JSONL forensic log of every OpenRouter call (success + failure, full
# request/response), run lifecycle, model swaps, and unhandled errors. Read it
# off disk (tail/grep) — there is no log DB table or endpoint in v1. Secrets are
# always stripped. Files rotate daily: <LOG_DIR>/app-YYYY-MM-DD.jsonl.
LOG_DIR=apps/api/data/logs
# Set false for console-only logging (e.g. under test):
LOG_TO_FILE=true
# Minimum level written: info | warn | error
LOG_LEVEL=info

# --- Database (SPEC §4) — points at your locally-installed Postgres (no Docker) ---
# Create a local database + user, then set this to match. Example:
DATABASE_URL=postgres://tribunal:tribunal@localhost:5432/tribunal

# --- Auth (SPEC §7) ---
# Use a long random string for JWT_SECRET (e.g. `openssl rand -hex 32`).
JWT_SECRET=
JWT_EXPIRES_IN=1d
SEED_USERNAME=
SEED_PASSWORD=

# --- File sources (SPEC §8, §4.2b) — resolved from the workspace root ---
PERSONAS_FILE=personalities.json
CHARGE_SHEET_SEED_FILE=charge-sheet.seed.txt

# --- HTTP (SPEC §7) ---
# Comma-separated list of allowed frontend origins for CORS:
CORS_ORIGINS=http://localhost:4200
PORT=3000
